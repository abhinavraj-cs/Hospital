generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}













model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          String
  refreshToken  String?
  patient       Patient?
  doctor        Doctor?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Patient {
  id         String       @id @default(uuid())
  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id])
  queueEntry QueueEntry[]
  encounters Encounter[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Hospital {
  id          String       @id @default(uuid())
  name        String
  address     String
  latitude    Float?
  longitude   Float?
  contact     String?
  buildings   Building[]
  departments Department[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Building {
  id         String     @id @default(uuid())
  hospitalId String
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])
  name       String
  code       String
  floors     Floor[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Floor {
  id          String           @id @default(uuid())
  buildingId  String
  building    Building         @relation(fields: [buildingId], references: [id])
  floorNumber Int
  name        String
  departments Department[]
  rooms       Room[]
  nodes       NavigationNode[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Department {
  id         String             @id @default(uuid())
  hospitalId String
  hospital   Hospital           @relation(fields: [hospitalId], references: [id])
  floorId    String
  floor      Floor              @relation(fields: [floorId], references: [id])
  name       String
  code       String
  category   String
  rooms            Room[]
  doctors          Doctor[]
  queues           Queue[]
  navigationNodes  NavigationNode[]
  encounters       Encounter[]
  createdAt        DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Room {
  id           String      @id @default(uuid())
  floorId      String
  floor        Floor       @relation(fields: [floorId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  roomNumber   String      @unique
  name         String
  type         String
  doctors      Doctor[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Doctor {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id])
  employeeId         String       @unique
  specialization     String
  departmentId       String
  department         Department   @relation(fields: [departmentId], references: [id])
  roomId             String?
  room               Room?        @relation(fields: [roomId], references: [id])
  availabilityStatus String
  consultationStart  String
  consultationEnd    String
  queues             Queue[]
  encounters         Encounter[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Queue {
  id                      String       @id @default(uuid())
  doctorId                String       @unique
  doctor                  Doctor       @relation(fields: [doctorId], references: [id])
  departmentId            String
  department              Department   @relation(fields: [departmentId], references: [id])
  currentNumber           Int          @default(0)
  waitingCount            Int          @default(0)
  averageConsultationTime Int          @default(15)
  isActive                Boolean      @default(true)
  entries                 QueueEntry[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model QueueEntry {
  id          String           @id @default(uuid())
  queueId     String
  queue       Queue            @relation(fields: [queueId], references: [id])
  patientId   String
  patient     Patient          @relation(fields: [patientId], references: [id])
  tokenNumber Int
  status      String @default("WAITING")
  calledAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model NavigationNode {
  id           String           @id @default(uuid())
  floorId      String
  floor        Floor            @relation(fields: [floorId], references: [id])
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  x            Float
  y            Float
  nodeType     String
  label        String?
  accessible   Boolean          @default(true)
  roomId       String?
  buildingId   String?
  metadata     Json?
  edgesFrom    NavigationEdge[] @relation("EdgeFrom")
  edgesTo      NavigationEdge[] @relation("EdgeTo")
  qrCodes      QRCodeLocation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model NavigationEdge {
  id               String         @id @default(uuid())
  fromNodeId       String
  fromNode         NavigationNode @relation("EdgeFrom", fields: [fromNodeId], references: [id])
  toNodeId         String
  toNode           NavigationNode @relation("EdgeTo", fields: [toNodeId], references: [id])
  distance         Float
  accessible       Boolean        @default(true)
  elevatorRequired Boolean        @default(false)
  stairsRequired   Boolean        @default(false)
  isEmergencyRoute Boolean        @default(false)
  bidirectional    Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model QRCodeLocation {
  id        String         @id @default(uuid())
  nodeId    String
  node      NavigationNode @relation(fields: [nodeId], references: [id])
  code      String         @unique
  label     String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  details   String?
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Appointment {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  date      DateTime
  status    String   @default("SCHEDULED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Encounter {
  id              String            @id @default(uuid())
  encounterNumber String            @unique
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctorId        String?
  doctor          Doctor?           @relation(fields: [doctorId], references: [id])
  departmentId    String?
  department      Department?       @relation(fields: [departmentId], references: [id])
  status          String            @default("ACTIVE")
  currentLevel    String            @default("LV1_PATIENT")
  priority        String            @default("NORMAL")
  chiefComplaint  String?
  diagnosis       String?
  tokens          MultiLevelToken[]
  prescriptions   Prescription[]
  labRequests     LabTestRequest[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MultiLevelToken {
  id            String     @id @default(uuid())
  encounterId   String
  encounter     Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId     String
  level         String     // LV1_PATIENT, LV2_DOCTOR, LV3_PHARMACY, LV4_LAB_TEST, LV5_LAB_REPORT
  tokenCode     String     @unique // e.g. PAT-101, DOC-201, PH-301, LAB-401, REP-501
  tokenNumber   Int        // e.g. 101, 201, 301, 401, 501
  status        String     @default("WAITING") // WAITING, CALLED, IN_PROGRESS, ON_HOLD, COMPLETED, SKIPPED, CANCELLED
  departmentId  String?
  doctorId      String?
  notes         String?
  parentTokenId String?
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Prescription {
  id           String     @id @default(uuid())
  encounterId  String
  encounter    Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  medicines    String     // JSON array of medicines or text
  instructions String?
  status       String     @default("PENDING") // PENDING, DISPENSED
  dispensedAt  DateTime?
  dispensedBy  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LabTestRequest {
  id           String     @id @default(uuid())
  encounterId  String
  encounter    Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  testName     String
  testCategory String?
  status       String     @default("PENDING") // PENDING, SAMPLE_COLLECTED, PROCESSING, COMPLETED, CANCELLED
  sampleType   String?
  collectedAt  DateTime?
  completedAt  DateTime?
  report       LabReport?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LabReport {
  id               String         @id @default(uuid())
  labTestRequestId String         @unique
  labTestRequest   LabTestRequest @relation(fields: [labTestRequestId], references: [id], onDelete: Cascade)
  reportTokenCode  String?
  summary          String
  results          String
  status           String         @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, DELIVERED
  verifiedBy       String?
  verifiedAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

